          "name": "Créer un stage avec une référence automatique",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut HTTP 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Le backend a généré la référence de stage', function () {",
