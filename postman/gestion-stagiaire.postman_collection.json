    {
      "name": "3 - Projets",
      "description": "Renseigner departmentId dans l'environnement avant d'exécuter ces requêtes.",
      "item": [
        {
          "name": "Créer un projet avec un code automatique",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut HTTP 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Le backend a généré un code projet', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.projectCode).to.match(/^PRJ-\\d{4}-\\d{4,}$/);",
                  "  pm.environment.set('createdProjectId', data.id);",
                  "  pm.environment.set('generatedProjectCode', data.projectCode);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Projet Postman {{$randomUUID}}\",\n  \"description\": \"Test de génération automatique du code projet\",\n  \"gitlabLink\": \"https://gitlab.example.com/equipe/projet-postman\",\n  \"startDate\": \"2026-09-01\",\n  \"endDate\": \"2026-12-31\",\n  \"status\": \"PLANNED\",\n  \"departmentId\": \"{{departmentId}}\"\n}",
