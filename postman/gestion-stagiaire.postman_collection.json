{
  "info": {
    "_postman_id": "8bd85889-3141-4a75-97cf-b84709c063eb",
    "name": "Gestion stagiaire - API",
    "description": "Tests Postman du backend NestJS de gestion des stagiaires. Importer aussi l'environnement fourni et remplacer uniquement les mots de passe dans Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Santé",
      "item": [
        {
          "name": "Vérifier la connexion MySQL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('La base MySQL répond', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.status).to.eql('ok');",
                  "  pm.expect(data.database).to.eql('mysql');",
                  "  pm.expect(data.roleCount).to.be.a('number');",
                  "  pm.expect(data.checkedAt).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/database",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "database"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 - Authentification",
      "item": [
        {
          "name": "Connexion administrateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('JWT et profil administrateur présents', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.tokenType).to.eql('Bearer');",
                  "  pm.expect(data.user.email).to.eql(pm.environment.get('adminEmail'));",
                  "  pm.expect(data.user.role).to.eql('ADMINISTRATEUR');",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Profil administrateur avec JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Le profil administrateur est retourné', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.email).to.eql(pm.environment.get('adminEmail'));",
                  "  pm.expect(data.role).to.eql('ADMINISTRATEUR');",
                  "  pm.expect(data).not.to.have.property('passwordHash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
